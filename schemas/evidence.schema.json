{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrollforge.dev/schemas/evidence.schema.json",
  "title": "ScrollForge Evidence Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "sourceSha256",
    "environment",
    "commands",
    "artifacts",
    "claims"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "environment": {
      "type": "object",
      "required": [
        "node",
        "platform"
      ],
      "properties": {
        "node": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "command",
          "exitCode"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exitCode": {
            "type": "integer"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "classification"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "measured",
              "estimated",
              "unknown"
            ]
          },
          "evidenceRef": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
