{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scrollforge.dev/schemas/project.schema.json",
  "title": "ScrollForge Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "framework",
    "fit",
    "qualityProfile",
    "scrollDistance"
  ],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "framework": {
      "enum": [
        "next",
        "react",
        "vite",
        "vanilla"
      ]
    },
    "fit": {
      "enum": [
        "cover",
        "contain"
      ]
    },
    "qualityProfile": {
      "enum": [
        "quality",
        "balanced",
        "performance"
      ]
    },
    "scrollDistance": {
      "type": "integer",
      "minimum": 400,
      "maximum": 20000
    },
    "targetFps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "cdnBaseUrl": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
